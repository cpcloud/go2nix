# tests/nix/large_manifest_test.nix — regression for the link and test
# manifests reaching the application derivation's build as exported
# environment variables.
#
# Both manifests carry one localArchives entry per local package. Linux
# refuses an execve whose environment holds a single string of 128 KiB or
# more, so with the manifests exported the first external command stdenv
# runs fails with "Argument list too long" before the hook does anything.
# The test tells the two apart only where that limit is 128 KiB (Linux with
# 4 KiB pages); with larger pages and on darwin it passes either way.
#
# Generates a module of 220 one-line packages under a 209-character module
# path (about 650 bytes per entry, both manifests above 128 KiB), checks the
# sizes so a smaller tree cannot pass by accident, then builds it with
# doCheck and runs the binary.
{
  flake,
  pkgs,
  system,
  ...
}:
if !(flake.packages.${system} ? go2nix-nix-plugin) then
  pkgs.runCommand "large-manifest-test-unsupported" { meta.platforms = pkgs.lib.platforms.linux; } ''
    echo "large-manifest-test requires go2nix-nix-plugin (Linux only)" >&2
    exit 1
  ''
else
  let
    plugin = flake.packages.${system}.go2nix-nix-plugin;
    nix = pkgs.nixVersions.nix_2_34;
    nixpkgsPath = pkgs.path;
    go2nixSrc = flake;

    dag = pkgs.writeText "dag.nix" ''
      let
        pkgs = import <nixpkgs> { };
        inherit (pkgs) go;
        go2nix = import ${go2nixSrc}/packages/go2nix { inherit pkgs; };
        goEnv = import ${go2nixSrc}/nix/mk-go-env.nix {
          inherit go go2nix;
          inherit (pkgs) callPackage;
        };
      in
      goEnv.buildGoApplication {
        pname = "large-manifest";
        version = "0.0.1";
        src = ./.;
        goLock = ./go2nix.toml;
        doCheck = true;
      }
    '';
  in
  pkgs.runCommand "large-manifest-test"
    {
      nativeBuildInputs = [ nix ];
      requiredSystemFeatures = [ "recursive-nix" ];
    }
    ''
      export HOME=$(mktemp -d)
      export NIX_CONFIG="extra-experimental-features = nix-command recursive-nix"
      mkdir -p "$TMPDIR/empty-gmc"

      n=220
      seg=$(printf 'x%.0s' $(seq 60))
      mod="example.com/large-manifest/$seg/$seg/$seg"

      fx=$TMPDIR/fixture
      mkdir -p "$fx"
      cp ${dag} "$fx/dag.nix"
      printf 'module %s\n\ngo 1.25\n' "$mod" > "$fx/go.mod"
      printf '# go2nix lockfile v2. Generated by go2nix. Do not edit.\n\n[mod]\n' > "$fx/go2nix.toml"
      {
        printf 'package main\n\nimport (\n\t"fmt"\n\n'
        for i in $(seq 0 $((n - 1))); do
          p=$(printf 'p%03d' "$i")
          mkdir "$fx/$p"
          printf 'package %s\n\nfunc V() int { return %d }\n' "$p" "$i" > "$fx/$p/p.go"
          printf '\t"%s/%s"\n' "$mod" "$p"
        done
        printf ')\n\nfunc main() {\n\tsum := 0\n'
        for i in $(seq 0 $((n - 1))); do
          printf '\tsum += p%03d.V()\n' "$i"
        done
        printf '\tfmt.Println(sum)\n}\n'
      } > "$fx/main.go"
      # One test, so checkPhase reads the test manifest and runs something.
      printf 'package p000\n\nimport "testing"\n\nfunc TestV(t *testing.T) {\n\tif V() != 0 {\n\t\tt.Fatal("V() != 0")\n\t}\n}\n' \
        > "$fx/p000/p_test.go"

      for m in linkManifestJSON testManifestJSON; do
        size=$(GOMODCACHE="$TMPDIR/empty-gmc" nix-instantiate --eval --read-write-mode --raw \
          -I nixpkgs=${nixpkgsPath} \
          --option plugin-files "${plugin}/lib/nix/plugins/libgo2nix_plugin.so" \
          -E "toString (builtins.stringLength (import $fx/dag.nix).$m)")
        echo "$m: $size bytes"
        if [ "$size" -le 131072 ]; then
          echo "FAIL: $m is $size bytes, the generated module no longer pushes it past 128 KiB" >&2
          exit 1
        fi
      done

      drv=$(GOMODCACHE="$TMPDIR/empty-gmc" nix-instantiate "$fx/dag.nix" \
        -I nixpkgs=${nixpkgsPath} \
        --option plugin-files "${plugin}/lib/nix/plugins/libgo2nix_plugin.so")

      # Under recursive-nix the inner build's output goes to the daemon's
      # per-derivation log, not to nix-build's stderr.
      if ! result=$(nix-build "$drv" --no-out-link); then
        echo "FAIL: the application derivation did not build; its log: nix log $drv" >&2
        exit 1
      fi

      want=$((n * (n - 1) / 2))
      got=$("$result/bin/large-manifest")
      if [ "$got" != "$want" ]; then
        echo "FAIL: binary printed '$got', want '$want'" >&2
        exit 1
      fi

      echo "large-manifest-test: $n local packages, both manifests above 128 KiB, built with doCheck, binary prints $got" > $out
    ''
